# ClassPass Studios login (required)
CLASSPASS_EMAIL=your-email@example.com
CLASSPASS_PASSWORD=your-password

# Optional: run with visible browser for debugging
# HEADED=1

# Optional: pause (seconds) after filling login credentials before clicking submit (default 10; 0 = no pause)
# PAUSE_AFTER_CREDENTIALS=10

# Optional: when page extraction finds no data, write report page text to reports-pdf/<studio>-page-snippet.txt for debugging
# PAGE_SNIPPET=1

# Optional: report period (default: Jan 2026)
# REPORT_YEAR=2026
# REPORT_MONTH=01

# Backfill: start month for backfill.js (default: 2022-08)
# BACKFILL_START=2022-08

# BigQuery (insert runs after scrape when these are set)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
BIGQUERY_DATASET=your_dataset
BIGQUERY_TABLE=classpass_revenue
# Credentials: set path to service account JSON key, OR run: gcloud auth application-default login
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/your-service-account-key.json

# Optional: Slack Incoming Webhook URL for monthly-job.js (posted after BigQuery insert).
# 🚨 if 0 rows inserted; 🟢 if inserted row count equals number of studios (see lib/config.js STUDIO_IDS).
# Create a webhook under Slack → Apps → Incoming Webhooks, then set the full URL here (do not commit the real value).
# SLACK_WEBHOOK_URL=
